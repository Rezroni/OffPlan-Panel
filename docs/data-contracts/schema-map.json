        "budget_year": { "target": "year", "type": "integer", "nullable": false, "policy": "never substitute current year" },
        "service_cost": { "target": "raw_service_cost", "type": "real", "nullable": false, "unit_note": "Unstated billing unit; annual_charge_per_sqft set to null to avoid false sqft assumptions" },
        "property_group_name_en": { "target": "building_name_en", "type": "text", "nullable": true },
        "master_community_name_en": { "target": "area_name_en", "type": "text", "nullable": true },
        "service_category_name_en": { "target": "charge_category", "type": "text", "nullable": true },
        "project_id": { "target": "matched_project_id", "type": "text", "nullable": true, "prefix": "proj_dld_" }
      }
    },
